# 复制为 .env，改完直接 npm start 即可（v1.7.4 起程序会自动读取本文件）。
# 也可以在启动命令/服务单元里设置环境变量；已存在的环境变量优先级高于本文件。
# MySQL 连接（二选一）：整串 URL 或分项

# 方式一：整串
MYSQL_URL=mysql://ai_gateway:密码@127.0.0.1:3306/ai_gateway

# 方式二：分项
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=ai_gateway
# MYSQL_PASSWORD=密码
# MYSQL_DATABASE=ai_gateway

# 服务
PORT=8787
HOST=0.0.0.0

# 备份快照目录（可选）
# GW_DATA_DIR=/var/lib/ai-gateway

# 端到端测试专用库（不要指向生产库）
# GW_TEST_MYSQL_URL=mysql://root:密码@127.0.0.1:3306/ai_gateway_test
